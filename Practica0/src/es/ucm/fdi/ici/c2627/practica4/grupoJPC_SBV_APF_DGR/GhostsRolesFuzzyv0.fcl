// Fantasmas · v2: roles, cárcel, supervivencia y limpieza de prioridades adaptado a Lógica Difusa
// Nota: Se han añadido variables de entrada como 'ranking' (para los roles) y 'ventajaPP' 
// (para comparar distancias), ya que la lógica difusa evalúa grados, no comparaciones directas.

FUNCTION_BLOCK Ghost

VAR_INPUT
   distPacman : REAL;        // Distancia a Ms. Pac-Man (0 a 300)
   tiempoComestible : REAL;  // Turnos restantes siendo comestible (0: no lo soy)
   enCarcel : REAL;          // 0: libre, 1: en la cárcel
   distPPMsPacman : REAL;    // Distancia de Ms. Pac-Man a su Power Pill más cercana
   ventajaPP : REAL;         // 1: Estoy más cerca de la PP que Ms. Pac-Man, 0: Ella está más cerca
   ranking : REAL;           // Mi posición de cercanía respecto a otros fantasmas (0: 1º, 1: 2º, 2: 3º, 3: 4º)
   amigosCerca : REAL;       // Número de fantasmas en un radio cercano (para cerrar cerco)
   numPills : REAL;          // Píldoras normales restantes
   numPP : REAL;             // Píldoras de poder restantes
END_VAR

VAR_OUTPUT                   // Acciones posibles (se ejecutará la de mayor valor tras defuzzificar)
   perseguir : REAL;
   interceptar : REAL;
   emboscar : REAL;
   patrullar : REAL;
   cortar_pp : REAL;
   cerco : REAL;
   salir_carcel : REAL;
   huir : REAL;
   huir_disperso : REAL;
END_VAR

// ================= FUZZIFICACIÓN DE ENTRADAS =================

FUZZIFY distPacman
   TERM panico := (0, 1) (35, 1) (45, 0);       // Umbral 40 (G2a)
   TERM media := trian 30 100 200;              // Radio de cerco (R6)
   TERM lejos := (150, 0) (220, 1) (300, 1);
END_FUZZIFY

FUZZIFY tiempoComestible
   TERM no := (0, 1) (1, 0);
   TERM poco := trian 1 10 20;                  // Para G2c (seguro)
   TERM mucho := (15, 0) (30, 1) (200, 1);
END_FUZZIFY

FUZZIFY enCarcel
   TERM no := (0, 1) (0.5, 0);
   TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

FUZZIFY distPPMsPacman
   TERM peligro := (0, 1) (12, 1) (18, 0);      // Umbral 15 (G3)
   TERM segura := (15, 0) (30, 1) (300, 1);
END_FUZZIFY

FUZZIFY ventajaPP
   TERM no := (0, 1) (0.5, 0);
   TERM si := (0.5, 0) (1, 1);                  // R5: Yo estoy más cerca que ella
END_FUZZIFY

FUZZIFY ranking
   TERM primero := (0, 1) (0.5, 0);             // Acosador
   TERM segundo := trian 0.5 1 1.5;             // Bloqueador
   TERM tercero := trian 1.5 2 2.5;             // Emboscador
   TERM cuarto := (2.5, 0) (3, 1);              // Dispersor
END_FUZZIFY

FUZZIFY amigosCerca
   TERM pocos := (0, 1) (1, 0);
   TERM varios := (0.5, 0) (1, 1) (4, 1);       // Al menos otro fantasma cerca (R6)
END_FUZZIFY

FUZZIFY numPills
   TERM pocas := (0, 1) (15, 1) (25, 0);        // Fase final (< 20)
   TERM muchas := (20, 0) (40, 1) (300, 1);
END_FUZZIFY

FUZZIFY numPP
   TERM cero := (0, 1) (1, 0);
   TERM quedan := (0, 0) (1, 1) (4, 1);
END_FUZZIFY

// ================= DEFUZZIFICACIÓN DE SALIDAS =================
// Por brevedad de código, todas las acciones comparten la misma estructura geométrica de salida.

DEFUZZIFY perseguir
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY interceptar
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY emboscar
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY patrullar
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY cortar_pp
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY cerco
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY salir_carcel
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY huir
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY

DEFUZZIFY huir_disperso
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY

// ================= BASE DE REGLAS =================

RULEBLOCK reglas
   AND : MIN;
   ACT : MIN;
   ACCU : MAX;

   // ---- G4: Supervivencia Crítica (Prioridad Absoluta) ----
   RULE 1 : IF enCarcel IS si THEN salir_carcel IS mucho;

   // ---- G2: Supervivencia Comestible ----
   // G2a: Peligro inminente
   RULE 2 : IF tiempoComestible IS NOT no AND distPacman IS panico THEN huir IS mucho;
   // G2b: Distancia de seguridad y dispersión
   RULE 3 : IF tiempoComestible IS NOT no AND distPacman IS media THEN huir_disperso IS mucho;
   // G2c: Fin de efecto comestible inminente y lejos
   RULE 4 : IF tiempoComestible IS poco AND distPacman IS lejos THEN perseguir IS mucho;

   // ---- G3: Peligro de Power Pill ----
   RULE 5 : IF enCarcel IS no AND tiempoComestible IS no AND distPPMsPacman IS peligro THEN huir IS mucho;

   // ---- R5 y R6: Intervenciones Tácticas ----
   // R5: Cortar camino a la PP (estoy más cerca que ella)
   RULE 6 : IF enCarcel IS no AND tiempoComestible IS no AND ventajaPP IS si THEN cortar_pp IS mucho;
   // R6: Cerrar cerco con otros fantasmas
   RULE 7 : IF enCarcel IS no AND tiempoComestible IS no AND distPacman IS media AND amigosCerca IS varios THEN cerco IS mucho;

   // ---- R1 a R4: Asignación de Roles por Ranking ----
   // Solo aplican fuertemente si estoy libre y no soy comestible
   RULE 8 : IF enCarcel IS no AND tiempoComestible IS no AND ranking IS primero THEN perseguir IS mucho;
   RULE 9 : IF enCarcel IS no AND tiempoComestible IS no AND ranking IS segundo THEN interceptar IS mucho;
   RULE 10: IF enCarcel IS no AND tiempoComestible IS no AND ranking IS tercero THEN emboscar IS mucho;
   RULE 11: IF enCarcel IS no AND tiempoComestible IS no AND ranking IS cuarto THEN patrullar IS mucho;

   // ---- Fase Final sin PP ----
   RULE 12: IF enCarcel IS no AND tiempoComestible IS no AND numPills IS pocas AND numPP IS cero THEN perseguir IS mucho;

END_RULEBLOCK

END_FUNCTION_BLOCK