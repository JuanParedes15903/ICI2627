// Fantasmas · v1: coherencia de prioridades y huecos (solo FCL, mismas variables y acciones que v0)
// Niveles por COG: mucho (~8.2-8.7) > algo (5) > poco (~1.3-2)
//   mucho = emergencias | algo = cerco | poco = roles

FUNCTION_BLOCK Ghost

VAR_INPUT
   distPacman : REAL;
   tiempoComestible : REAL;
   enCarcel : REAL;
   distPPMsPacman : REAL;
   ventajaPP : REAL;
   ranking : REAL;
   amigosCerca : REAL;
   numPills : REAL;
   numPP : REAL;
END_VAR

VAR_OUTPUT
   perseguir : REAL;
   interceptar : REAL;
   emboscar : REAL;
   patrullar : REAL;
   cortar_pp : REAL;
   cerco : REAL;
   salir_carcel : REAL;
   huir : REAL;
   huir_disperso : REAL;
END_VAR

FUZZIFY distPacman
   TERM panico := (0, 1) (35, 1) (45, 0);
   TERM media := trian 30 100 200;
   TERM lejos := (150, 0) (220, 1) (300, 1);
END_FUZZIFY

FUZZIFY tiempoComestible
   TERM no := (0, 1) (1, 0);
   TERM poco := trian 1 10 20;
   TERM mucho := (15, 0) (30, 1) (200, 1);
END_FUZZIFY

FUZZIFY enCarcel
   TERM no := (0, 1) (0.5, 0);
   TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

FUZZIFY distPPMsPacman
   TERM peligro := (0, 1) (12, 1) (18, 0);
   TERM cercana := (0, 1) (60, 1) (100, 0);     // NUEVO: la PP es objetivo inmediato de Ms. Pac-Man
   TERM segura := (15, 0) (30, 1) (300, 1);
END_FUZZIFY

FUZZIFY ventajaPP
   TERM no := (0, 1) (0.5, 0);
   TERM si := (0.5, 0) (1, 1);
END_FUZZIFY

FUZZIFY ranking
   TERM primero := (0, 1) (0.5, 0);
   TERM segundo := trian 0.5 1 1.5;
   TERM tercero := trian 1.5 2 2.5;
   TERM cuarto := (2.5, 0) (3, 1);
END_FUZZIFY

FUZZIFY amigosCerca
   TERM pocos := (0, 1) (1, 0);
   TERM varios := (0.5, 0) (1, 1) (4, 1);
END_FUZZIFY

FUZZIFY numPills
   TERM pocas := (0, 1) (15, 1) (25, 0);
   TERM muchas := (20, 0) (40, 1) (300, 1);
END_FUZZIFY

FUZZIFY numPP
   TERM cero := (0, 1) (1, 0);
   TERM quedan := (0, 0) (1, 1) (4, 1);
END_FUZZIFY

DEFUZZIFY perseguir
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY
DEFUZZIFY interceptar
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY
DEFUZZIFY emboscar
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY
DEFUZZIFY patrullar
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY
DEFUZZIFY cortar_pp
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY
DEFUZZIFY cerco
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY
DEFUZZIFY salir_carcel
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY
DEFUZZIFY huir
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY
DEFUZZIFY huir_disperso
   TERM poco := (0, 1) (4, 0); TERM algo := trian 2 5 8; TERM mucho := (6, 0) (10, 1);
   METHOD : COG; DEFAULT := 0;
END_DEFUZZIFY

RULEBLOCK reglas
   AND : MIN;
   ACT : MIN;
   ACCU : MAX;

   // ---- Nivel MUCHO: emergencias ----
   RULE 1 : IF enCarcel IS si THEN salir_carcel IS mucho;
   RULE 2 : IF tiempoComestible IS NOT no AND distPacman IS panico THEN huir IS mucho;
   RULE 3 : IF tiempoComestible IS NOT no AND distPacman IS media THEN huir_disperso IS mucho;
   RULE 4 : IF tiempoComestible IS poco AND distPacman IS lejos THEN perseguir IS mucho;
   // NUEVA: hueco de v0 (comestible, mucho tiempo, lejos)
   RULE 5 : IF tiempoComestible IS mucho AND distPacman IS lejos THEN huir_disperso IS mucho;
   // CAMBIO: solo huye si ella llega antes a la PP (si llego yo antes, corto)
   RULE 6 : IF enCarcel IS no AND tiempoComestible IS no AND distPPMsPacman IS peligro AND ventajaPP IS no THEN huir IS mucho;
   // CAMBIO: solo corto si ella esta cerca de la PP
   RULE 7 : IF enCarcel IS no AND tiempoComestible IS no AND ventajaPP IS si AND distPPMsPacman IS cercana THEN cortar_pp IS mucho;
   RULE 8 : IF enCarcel IS no AND tiempoComestible IS no AND numPills IS pocas AND numPP IS cero THEN perseguir IS mucho;

   // ---- Nivel ALGO: coordinacion de equipo ----
   RULE 9 : IF enCarcel IS no AND tiempoComestible IS no AND distPacman IS media AND amigosCerca IS varios THEN cerco IS algo;

   // ---- Nivel POCO: roles por defecto ----
   RULE 10: IF enCarcel IS no AND tiempoComestible IS no AND ranking IS primero THEN perseguir IS poco;
   RULE 11: IF enCarcel IS no AND tiempoComestible IS no AND ranking IS segundo THEN interceptar IS poco;
   RULE 12: IF enCarcel IS no AND tiempoComestible IS no AND ranking IS tercero THEN emboscar IS poco;
   RULE 13: IF enCarcel IS no AND tiempoComestible IS no AND ranking IS cuarto AND numPP IS quedan THEN patrullar IS poco;
   // NUEVA: sin PPs, patrullar es aleatorio; el cuarto ayuda a cerrar el cerco
   RULE 14: IF enCarcel IS no AND tiempoComestible IS no AND ranking IS cuarto AND numPP IS cero THEN cerco IS poco;

END_RULEBLOCK

END_FUNCTION_BLOCK